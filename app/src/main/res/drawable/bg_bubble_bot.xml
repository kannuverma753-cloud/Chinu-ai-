<?xml version="1.0" encoding="utf-8"?>
<!-- 💧 liquid glass -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="6dp" android:topRightRadius="20dp" android:bottomLeftRadius="20dp" android:bottomRightRadius="20dp" />
            <solid android:color="@color/glassFill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="6dp" android:topRightRadius="20dp" android:bottomLeftRadius="20dp" android:bottomRightRadius="20dp" />
            <gradient android:angle="270" android:startColor="@color/glassShine" android:centerColor="@color/clear" android:endColor="@color/glassEdge" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="6dp" android:topRightRadius="20dp" android:bottomLeftRadius="20dp" android:bottomRightRadius="20dp" />
            <stroke android:width="1.2dp" android:color="@color/glassRim" />
        </shape>
    </item>
</layer-list>
