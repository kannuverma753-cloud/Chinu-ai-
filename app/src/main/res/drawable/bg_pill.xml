<?xml version="1.0" encoding="utf-8"?>
<!-- 💧 liquid glass -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/pressed">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="@color/glassFill" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient android:angle="270" android:startColor="@color/glassShine" android:centerColor="@color/clear" android:endColor="@color/glassEdge" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <stroke android:width="1.2dp" android:color="@color/glassRim" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
